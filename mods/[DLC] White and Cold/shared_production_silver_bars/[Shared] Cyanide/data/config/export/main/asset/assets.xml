<ModOps>
	<!-- Product "Ammonia" -->
  	<ModOp GUID='11703' Type="addNextSibling">
    		<Asset>
      			<Template>Product</Template>
			<Values>
  				<Standard>
    					<GUID>1957006121</GUID>
    					<Name>Cyanide</Name>
                    	<IconFilename>data/ui/2kimages/main/3dicons/scenario/goods/icon_ammonia.png</IconFilename>
    					<InfoDescription>1957006221</InfoDescription>
  				</Standard>
        			<Text>
          				<LocaText />
          				<LineID>5385</LineID>
        			</Text>
  				<Locked/>
  				<Product>
    					<StorageLevel>Building</StorageLevel>
    					<ProductCategory>11703</ProductCategory>
    					<BasePrice>200</BasePrice>
    					<CivLevel>4</CivLevel>
    					<AssociatedRegion>Moderate;Colony01;Africa</AssociatedRegion>
    					<ProductionRegions>
      						<Item>
        						<RegionType>Moderate</RegionType>
      						</Item>
      						<Item>
        						<RegionType>Colony01</RegionType>
      						</Item>
    					</ProductionRegions>
  				</Product>
  				<ExpeditionAttribute>
    					<BaseMorale>5</BaseMorale>
  				</ExpeditionAttribute>
			</Values>    		
		</Asset>
  	</ModOp>

	<!-- Note: -->
	<!-- 	Here, ammonia is only assigned to the standard product list (after gold ore) -->
	<!-- 	It is up to the individual mods to administer other lists for their purposes -->
	<!-- 	To avoid double entries, they should always check existing contents -->
    	<ModOp Type="addNextSibling" GUID="120055" Path="/Values/ProductStorageList/ProductList/Item[Product='1010233']" 
	  	Condition="!~/Values/ProductStorageList/ProductList/Item[Product='1957006121']">	
      		<Item>
        		<Product>1957006121</Product>        
      		</Item>
    	</ModOp>

	<!-- Adding to docklands trader "Promise Trust" -->
	<ModOp Type="add" GUID='131764' Path="/Values/TradeContractFeature/Traders/Item[TraderName='131817']/TradeLevels/Item[Unlock='131846']/Trades" 
		Condition="!@131764/.//TradeLevels/Item/Trades[Item/Good='1957006121']"> 
		<Item>
			<Level>Rare</Level>			
			<Good>1957006121</Good>
		</Item>
	</ModOp>

	<!-- Fake factory (only for price calculation in docklands) -->
