            <Text>Okręty zbrojeniowe mogą przynieść ograniczoną ilość posiłków.</Text>            <!-- Visitorships can bring a limited amount of visitors. -->
        </Text>
        <Text>
            <GUID>2463</GUID>
            <Text>Umożliwia wzmocnienie zrobić przystanek na wyspie.</Text>            <!-- Enables visitors to make a stopover on your island. -->
        </Text>
