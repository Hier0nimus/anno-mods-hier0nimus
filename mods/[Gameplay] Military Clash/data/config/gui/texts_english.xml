        <Text>
            <GUID>2444</GUID>
            <Text>Reinforcements Leaving from [NotificationContext Value(Area) Area CityName].</Text>            <!-- Visitors Leaving from [NotificationContext Value(Area) Area CityName]. -->
        </Text>
        <Text>
            <GUID>2443</GUID>
            <Text>Many Reinforcements are cutting their stay short in [NotificationContext Value(Area) Area CityName].</Text>            <!-- Many Visitors are cutting their stay short in [NotificationContext Value(Area) Area CityName]. -->
        </Text>
        <Text>
            <GUID>2442</GUID>
            <Text>First Reinforcements in [NotificationContext Value(Area) Area CityName]!</Text>            <!-- First Visitors in [NotificationContext Value(Area) Area CityName]! -->
        </Text>
        <Text>
            <GUID>2441</GUID>
            <Text>[NotificationContext Value(Area) Area CityName] is welcoming Reinforcements for the first time!</Text>            <!-- [NotificationContext Value(Area) Area CityName] is welcoming Visitors for the first time! -->
        </Text>
        <Text>
            <GUID>2433</GUID>
            <Text>Many Reinforcements are arriving at your Reinforcements Harbour in [NotificationContext Value(Area) Area CityName].</Text>            <!-- Many new visitors are arriving at your Harbour in [NotificationContext Value(Area) Area CityName]. -->
