  				<Object>
    					<Variations>
      						<Item>
       							<Filename>data/graphics/buildings/production/coastal_02/coastal_02.cfg</Filename>
      						</Item>
	    				</Variations>
  				</Object>
  				<UpgradeList />
  				<Factory7 />
